  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/twemoji": "^1.2.5",
    "@playwright/test": "1.49.1",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "@unocss/astro": "^66.8.1",
    "@unocss/reset": "^66.8.1",
    "@vite-pwa/astro": "^1.2.0",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
