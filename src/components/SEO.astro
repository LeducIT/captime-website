---
import { appDescription, appName, defaultAuthor, seoKeywords } from '../constants'
import { canonicalUrl, defaultStructuredData, siteOrigin } from '../services/seo'

const {
  ldJSON = defaultStructuredData(),
  title = appName,
  description = appDescription,
  url,
  image,
  canonical,
  author = defaultAuthor,
  audio = null,
  type = 'website',
} = Astro.props

let displayDescription = description

const descSize = 170

if (description.length > descSize) {
  displayDescription = `${description.substring(0, descSize - 3)}...`
}

const origin = siteOrigin()
const resolvedCanonical = String(canonical || url || canonicalUrl(Astro.url.pathname))
const resolvedUrl = String(url || resolvedCanonical)
const resolvedImage = String(image || `${origin}/blog_meta.webp`).replace(/^http:\/\//, 'https://')
const titleFix = title || (resolvedImage.split('/').pop() || '.').split('.')[0]
const ogType = type === 'article' ? 'article' : 'website'
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="theme-color" content="#000000" />
<meta name="generator" content={Astro.generator} />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="apple-mobile-web-app-title" content="Captime" />
<meta name="apple-itunes-app" content="app-id=1369288585" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="keywords" content={seoKeywords} />
<meta name="robots" content="index, follow" />

<link rel="canonical" href={resolvedCanonical} />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/svg+xml" href="/safari-pinned-tab.svg" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="author" content={author} />
<meta name="description" content={displayDescription} />
<meta name="publisher" content="Captime" />

<!-- Open Graph / Facebook -->
<meta property="og:url" content={resolvedUrl} />
<meta property="og:title" content={title} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="627" />
<meta property="og:image:alt" content={titleFix} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:secure_url" content={resolvedImage} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:site_name" content="Captime" />
<meta property="og:description" content={displayDescription} />
{ogType === 'article' && <meta property="article:author" content={author} />}
{audio && <meta property="og:audio" content={audio} />}
{audio && <meta property="og:audio:type" content="audio/mpeg" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content="Captime" />
<meta name="twitter:url" content={resolvedUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={displayDescription} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={titleFix} />
<meta name="twitter:app:name:iphone" content="Captime" />
<meta name="twitter:app:id:iphone" content="1369288585" />
<meta name="twitter:app:name:googleplay" content="Captime" />
<meta name="twitter:app:id:googleplay" content="ee.forgr.captime" />

<script hid="seo-schema-graph" type="application/ld+json" set:html={ldJSON} />
