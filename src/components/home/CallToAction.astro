---
import { heroPhotoSizes, heroPhotoWidths, srcsetFor } from '../../lib/images'

const slides = [
  {
    title: 'Smash every workout.',
    content: "It's time to smash your workout goals and achieve the maximum results using this professional timer app.",
    name: 'hero_1',
    width: 1920,
    height: 1282,
  },
  {
    title: 'Home or gym, same timer.',
    content: 'It makes no difference if you workout at home or in the gym.',
    name: 'hero_3',
    width: 1920,
    height: 1283,
  },
  {
    title: 'Train anywhere.',
    content: 'Captime ensures that your workouts are effective regardless of where you train.',
    name: 'hero_2',
    width: 1920,
    height: 1280,
  },
]
---

{
  slides.map((slide) => (
    <section class="relative h-[85svh] max-h-[85svh] md:h-auto md:max-h-none md:pb-12">
      <picture class="block h-full w-full md:h-auto">
        <source type="image/avif" srcset={srcsetFor(slide.name, heroPhotoWidths, 'avif')} sizes={heroPhotoSizes} />
        <source type="image/webp" srcset={srcsetFor(slide.name, heroPhotoWidths, 'webp')} sizes={heroPhotoSizes} />
        <img
          class="h-full w-full object-cover opacity-50 md:h-auto"
          src={`/${slide.name}.webp`}
          srcset={srcsetFor(slide.name, heroPhotoWidths, 'webp')}
          sizes={heroPhotoSizes}
          width={slide.width}
          height={slide.height}
          loading="lazy"
          decoding="async"
          alt={`Illustration ${slide.content}`}
          title={`Illustration ${slide.content}`}
        />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/20 via-black/55 to-black/75" />
      <div class="absolute inset-0 flex items-center justify-center px-6">
        <div class="text-center max-w-2xl rounded-2xl bg-gradient-to-b from-black/70 via-black/50 to-transparent px-5 py-5 md:py-8">
          <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl xl:text-5xl">
            {slide.title}
          </h2>
          <p class="mx-auto mt-2 max-w-[28ch] text-base leading-relaxed text-gray-300 sm:max-w-xl sm:text-lg md:mt-3">
            {slide.content}
          </p>
          <a href="#hero-downloads" data-scroll-hero title="Download" class="btn-cta-md mt-5 md:mt-8">
            Smash wods <span class="font-handel text-[1.15em] tracking-wide">NOW</span>
          </a>
        </div>
      </div>
    </section>
  ))
}

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  for (const link of document.querySelectorAll('a[data-scroll-hero]')) {
    link.addEventListener('click', (event) => {
      const target = document.getElementById('hero-downloads')
      if (!target)
        return
      event.preventDefault()
      target.scrollIntoView({
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
        block: 'center',
      })
    })
  }
</script>
