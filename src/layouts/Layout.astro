---
import '../css/global.css'
import SEO from '../components/SEO.astro'
// @ts-ignore
import { pwaInfo } from 'virtual:pwa-info'
import Header from '../components/NavBar.vue'
import Footer from '../components/Footer.vue'

const { content, lcpPreload } = Astro.props
const blog = Astro.url.pathname.startsWith('/blog')
---

<!DOCTYPE html>
<html lang="en">
  <head>
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <link rel="preload" href="/fonts/Handel_Gothic.woff2" as="font" type="font/woff2" crossorigin />
    {lcpPreload?.srcset && (
      <link
        rel="preload"
        as="image"
        type={lcpPreload.type}
        imagesrcset={lcpPreload.srcset}
        imagesizes={lcpPreload.sizes}
        fetchpriority="high"
      />
    )}
    {lcpPreload?.href && !lcpPreload?.srcset && (
      <link rel="preload" as="image" href={lcpPreload.href} fetchpriority="high" />
    )}
    <SEO {...content} />
  </head>
  <body>
    <div class="overflow-x-hidden text-white">
      <Header client:load blog={blog} />
      <slot />
      <footer class="p-4 rounded-none shadow md:px-6 md:py-8">
        <Footer client:load />
        <span class="block text-sm text-white sm:text-center">© <span data-current-year>2026</span> <a href="/" class="hover:underline font-handel">Captime</a>. All Rights Reserved.</span>
      </footer>
      <script is:inline>
        (function () {
          var node = document.querySelector('[data-current-year]')
          if (node)
            node.textContent = String(new Date().getFullYear())
        })()
      </script>
    </div>
    <script
      is:inline
      async="true"
      defer="true"
      data-domain="captime.app"
      src="https://pls.digitalshift-ee.workers.dev/js/script.js"
      data-api="https://pls.digitalshift-ee.workers.dev/api/event"></script>
    <script>
      import { initAnalytics } from '../lib/analytics'
      initAnalytics()
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker
          .register('/sw.js')
          .then(function (registration) {
            console.log('SW registration succeeded with scope:', registration.scope)
          })
          .catch(function (e) {
            console.log('SW registration failed with error:', e)
          })
      }
    </script>
  </body>
</html>
