---
import Layout from '../layouts/Layout.astro'
import StoreBadges from '../components/StoreBadges.vue'
import DownloadQr from '../components/DownloadQr.vue'
import { useRuntimeConfig } from '../config/app'
import { appStoreUrl, playStoreUrl } from '../constants'

const content = {
  title: 'Download Captime',
  description: 'Get the Captime CrossFit timer on the App Store or Google Play.',
  canonical: `${useRuntimeConfig().public.baseUrl}/download`,
}
---

<Layout content={content}>
  <script is:inline define:vars={{ appStoreUrl, playStoreUrl }}>
    (function () {
      var ua = navigator.userAgent || ''
      var touch = navigator.maxTouchPoints || 0
      if (/iPhone|iPad|iPod/i.test(ua) || (/Macintosh/i.test(ua) && touch > 1))
        window.location.replace(appStoreUrl)
      else if (/Android/i.test(ua))
        window.location.replace(playStoreUrl)
    })()
  </script>
  <main class="px-6 py-16 text-center">
    <h1 class="font-handel text-3xl text-white sm:text-4xl">Get Captime</h1>
    <p class="mt-3 text-gray-400">Available on iPhone and Android.</p>
    <div class="mt-8">
      <StoreBadges />
    </div>
    <div class="mt-8 hidden md:flex justify-center">
      <DownloadQr />
    </div>
  </main>
</Layout>
