---
import Layout from '../../layouts/Layout.astro'
import { loadBlogPosts, parsePostDate } from '../../services/blog'
import { getRelatedKey } from '../../services/modes'
import { publisherOrg, useRuntimeConfig } from '../../config/app'
import VueBlogSlug from '../../vue-pages/blog/[slug].vue'
import { decorateContentImages } from '../../lib/images'

export async function getStaticPaths() {
  const posts = loadBlogPosts()
  return posts.map((post) => {
    const key = getRelatedKey(post.frontmatter)
    const related = key
      ? posts
          .filter((item) => item.frontmatter.slug !== post.frontmatter.slug)
          .filter((item) => item.frontmatter.published)
          .filter((item) => getRelatedKey(item.frontmatter) === key)
          .sort((a, b) => parsePostDate(b.frontmatter.created_at).getTime() - parsePostDate(a.frontmatter.created_at).getTime())
          .slice(0, 3)
      : []
    return {
      params: {
        slug: post.frontmatter.slug,
      },
      props: {
        post,
        related,
      },
    }
  })
}

const data = Astro.props.post
const related = Astro.props.related

const config = useRuntimeConfig()
const slug = data.frontmatter.slug
const canonical = `${config.public.baseUrl}/blog/${slug}/`
const fallbackImage = `${config.public.baseUrl}/blog_meta.webp`
const image = data.frontmatter.head_image
  ? data.frontmatter.head_image.startsWith('http')
    ? data.frontmatter.head_image
    : `${config.public.baseUrl}${data.frontmatter.head_image}`
  : fallbackImage

const markdown = decorateContentImages(String(await data.compiledContent() || ''))

const datePublished = parsePostDate(data.frontmatter.created_at).toISOString()
const dateModified = parsePostDate(data.frontmatter.updated_at || data.frontmatter.created_at).toISOString()

const content = {
  title: data.frontmatter.title,
  description: data.frontmatter.description,
  image,
  author: data.frontmatter.author || 'Captime',
  canonical,
  url: canonical,
  type: 'article',
  ldJSON: JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonical,
    },
    headline: data.frontmatter.title,
    image: [image],
    datePublished,
    dateModified,
    author: {
      '@type': 'Person',
      name: data.frontmatter.author || 'Captime',
      url: data.frontmatter.author_url || config.public.baseUrl,
    },
    publisher: publisherOrg,
  }),
}
---

<Layout
  content={content}
  lcpPreload={{
    href: data.frontmatter.head_image?.startsWith('http')
      ? data.frontmatter.head_image
      : (data.frontmatter.head_image || '/blog_meta.webp'),
  }}
>
  <VueBlogSlug toc={data.getHeadings()} related={related} Content={markdown} client:load {...data.frontmatter} />
</Layout>
