---
import Layout from '../../layouts/Layout.astro'
import { loadBlogPosts, parsePostDate } from '../../services/blog'
import { blogIndexStructuredData, useRuntimeConfig } from '../../config/app'
import { pageMeta } from '../../services/seo'
import VueBlogIndex from '../../vue-pages/blog/index.vue'

const posts = loadBlogPosts()
  .filter((item) => item.frontmatter.published)
  .sort((a, b) => parsePostDate(b.frontmatter.created_at).getTime() - parsePostDate(a.frontmatter.created_at).getTime())
  .map((item) => ({ frontmatter: item.frontmatter }))

const config = useRuntimeConfig()

const content = {
  ...pageMeta('/blog/', config.public.blog_title, config.public.blog_description),
  image: `${config.public.baseUrl}/blog_meta.webp`,
  ldJSON: blogIndexStructuredData(),
}
---

<Layout content={content} lcpPreload={{ href: '/amrap1.webp' }}>
  <VueBlogIndex Content={posts} client:load />
</Layout>
