---
import Layout from '../layouts/Layout.astro'
import VueIndex from '../vue-pages/index.vue'
import { homeStructuredData, pageMeta } from '../services/seo'

const content = {
  ...pageMeta(
    '/',
    'Captime | CrossFit Timer',
    'The Captime app offers a variety of workout timers for common CrossFit and high-intensity interval training workouts.',
  ),
  ldJSON: homeStructuredData(),
}
---

<Layout content={content}><VueIndex client:load /></Layout>
