---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/home/Hero.astro'
import CallToAction from '../components/home/CallToAction.astro'
import Features from '../components/home/Features.vue'
import Testimonials from '../components/home/Testimonials.vue'
import Trust from '../components/home/Trust.vue'
import FAQ from '../components/home/FAQ.vue'
import { heroDemoSizes, heroDemoWidths, srcsetFor } from '../lib/images'
import { homeStructuredData, pageMeta } from '../services/seo'

const content = {
  ...pageMeta(
    '/',
    'Captime | CrossFit Timer',
    'The Captime app offers a variety of workout timers for common CrossFit and high-intensity interval training workouts.',
  ),
  ldJSON: homeStructuredData(),
}

const lcpPreload = {
  type: 'image/avif',
  srcset: srcsetFor('app-demo', heroDemoWidths, 'avif'),
  sizes: heroDemoSizes,
}
---

<Layout content={content} lcpPreload={lcpPreload}>
  <Hero />
  <Features />
  <CallToAction />
  <Testimonials />
  <Trust />
  <FAQ client:visible />
</Layout>

<script>
  import { crispLoader } from '../services/crisp'

  window.addEventListener(
    'scroll',
    () => {
      crispLoader()
    },
    { capture: true, once: true, passive: true },
  )
</script>
