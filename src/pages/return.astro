---
import Layout from '../layouts/Layout.astro'
import VueReturn from '../vue-pages/return.vue'
import { useRuntimeConfig } from '../config/app'
import { pageMeta, webPageStructuredData } from '../services/seo'

const config = useRuntimeConfig()
const brand = config.public.brand
const title = `${brand} | Return Policy`
const description = 'Read the Captime return policy for the CrossFit timer app.'
const content = {
  ...pageMeta('/return/', title, description),
  ldJSON: webPageStructuredData('/return/', title, description),
}
---

<Layout content={content}><VueReturn client:load /></Layout>
