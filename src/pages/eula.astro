---
import Layout from '../layouts/Layout.astro'
import VueEula from '../vue-pages/eula.vue'
import { useRuntimeConfig } from '../config/app'
import { pageMeta, webPageStructuredData } from '../services/seo'

const config = useRuntimeConfig()
const brand = config.public.brand
const title = `${brand} | End-User License Agreement`
const description = 'Read the Captime End-User License Agreement for the CrossFit timer app.'
const content = {
  ...pageMeta('/eula/', title, description),
  ldJSON: webPageStructuredData('/eula/', title, description),
}
---

<Layout content={content}><VueEula client:load /></Layout>
