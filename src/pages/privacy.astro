---
import Layout from '../layouts/Layout.astro'
import VuePrivacy from '../vue-pages/privacy.vue'
import { useRuntimeConfig } from '../config/app'
import { pageMeta, webPageStructuredData } from '../services/seo'

const config = useRuntimeConfig()
const brand = config.public.brand
const title = `${brand} | Privacy Policy`
const description = 'Read the Captime Privacy Policy for the CrossFit timer app.'
const content = {
  ...pageMeta('/privacy/', title, description),
  ldJSON: webPageStructuredData('/privacy/', title, description),
}
---

<Layout content={content}><VuePrivacy client:load /></Layout>
