---
import VueTos from '../vue-pages/tos.vue'
import Layout from '../layouts/Layout.astro'
import { useRuntimeConfig } from '../config/app'
import { pageMeta, webPageStructuredData } from '../services/seo'

const config = useRuntimeConfig()
const brand = config.public.brand
const title = `${brand} | Terms of Service`
const description = 'Read the Captime Terms of Service for the CrossFit timer app.'
const content = {
  ...pageMeta('/tos/', title, description),
  ldJSON: webPageStructuredData('/tos/', title, description),
}
---

<Layout content={content}><VueTos client:load /></Layout>
