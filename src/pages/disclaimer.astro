---
import Layout from '../layouts/Layout.astro'
import { useRuntimeConfig } from '../config/app'
import VueDisclaimer from '../vue-pages/disclaimer.vue'
import { pageMeta, webPageStructuredData } from '../services/seo'

const config = useRuntimeConfig()
const brand = config.public.brand
const title = `${brand} | Disclaimer`
const description = 'Read the Captime disclaimer for the CrossFit timer app.'
const content = {
  ...pageMeta('/disclaimer/', title, description),
  ldJSON: webPageStructuredData('/disclaimer/', title, description),
}
---

<Layout content={content}><VueDisclaimer client:load /></Layout>
