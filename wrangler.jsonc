{
  "name": "captime-website",
  "account_id": "7b9faa6c8763d7b21d16c4707d55aadc",
  "compatibility_date": "2026-11-14",
  "main": "worker/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/go/*"]
  }
}
